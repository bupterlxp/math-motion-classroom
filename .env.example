# Required for real AI generation. Never put this value in frontend code.
OPENAI_API_KEY=sk-proj-your-key-here
# Optional. Defaults to gpt-5.6-sol.
OPENAI_MODEL=gpt-5.6-sol
# Optional. Defaults to https://api.openai.com/v1. Use an OpenAI-compatible proxy if needed.
# OPENAI_BASE_URL=https://api.tokenwave.us
# Optional. Used by the local server and Vercel function.
PORT=4173
# Optional. Restrict browser calls when the API is on another domain.
# ALLOWED_ORIGIN=https://your-name.github.io
